# Copy to .env.local and adjust. Every variable is optional.

# Base URL of the conversion API (usdm4_api, serves /v1/*).
VITE_CONVERT_API_URL=http://localhost:8080

# Base URL of the review API (serves /api/review/*; see docs/api-contract.md).
VITE_REVIEW_API_URL=http://localhost:8000

# How often a running conversion job is polled, in milliseconds.
VITE_JOB_POLL_INTERVAL_MS=10000

# "true" answers every API call with Mock Service Worker fixtures (no backend needed).
VITE_MOCKS=false
