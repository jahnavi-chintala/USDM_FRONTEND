# Copy to .env.local and adjust. Every variable is optional.

# Base URL of the protocol API (serves /api/protocols/*; see docs/api-contract.md).
VITE_API_URL=http://localhost:8080

# How often the app re-checks a protocol that is still processing, in milliseconds.
VITE_POLL_INTERVAL_MS=10000

# "true" answers every API call with Mock Service Worker fixtures (no backend needed).
VITE_MOCKS=false
